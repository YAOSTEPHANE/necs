# =============================================================================
# NECS — environnement
# App : Vercel  ·  Fichiers : Vercel Blob  ·  DB : MongoDB Atlas (recommandé)
# =============================================================================

# --- Auth (obligatoire pour /admin) ---
# openssl / node : crypto.randomBytes(32).toString('hex')
AUTH_SECRET=""

# Longueur minimale des mots de passe utilisateur (défaut 10)
PASSWORD_MIN_LENGTH="10"

# Premier admin créé automatiquement si la collection users est vide
# Mot de passe : ≥10 caractères, au moins une lettre et un chiffre
ADMIN_BOOTSTRAP_EMAIL="direction@necs.cm"
ADMIN_BOOTSTRAP_NAME="Direction NECS"
ADMIN_BOOTSTRAP_PASSWORD=""

# Inscription publique client (défaut : ouverte en local, fermée en production)
# REGISTER_ENABLED="true"
# REGISTER_INVITE_CODE=""

# --- MongoDB Atlas ---
# mongodb+srv://USER:PASS@cluster.mongodb.net/necs
DATABASE_URL=""

# --- Vercel Blob (stockage images / fichiers) ---
BLOB_READ_WRITE_TOKEN=""

# --- MySQL Hostinger (legacy / optionnel, non utilisé par l’auth actuelle) ---
DB_HOST=""
DB_PORT="3306"
DB_NAME=""
DB_USER=""
DB_PASSWORD=""
DB_SSL="true"

# --- E-mail réinitialisation MDP (Google Gmail SMTP — recommandé) ---
# Compte Google → Sécurité → Validation en 2 étapes → Mots de passe des applications
GMAIL_USER="contact@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
EMAIL_FROM="NECS <contact@gmail.com>"

# Secours optionnel Resend (si Google non configuré)
# RESEND_API_KEY=""
# RESEND_FROM="NECS <contact@votre-domaine.com>"

# --- Pointage mobile (OPS-04) ---
# Géolocalisation uniquement si retenue et applicable (défaut : off)
POINTAGE_GEO_ENABLED="false"
# Cible de recette : pointages simultanés sans perte ni duplication
POINTAGE_CONCURRENCY_TARGET="50"

# --- Mode offline / dégradé (OPS-05) ---
# File locale chiffrée navigateur (IndexedDB AES-GCM) ; sync via clientRequestId.
# Pas de variable serveur obligatoire : bascule auto navigator.onLine + bouton « Simuler offline ».

# --- CRM leads (notification commercial) ---
# Destinataire principal des alertes « nouveau prospect » (en plus des comptes rôle commercial)
LEADS_NOTIFY_EMAIL="commercial@necs.cm"
# Alias optionnel
# COMMERCIAL_EMAIL="commercial@necs.cm"

# --- Facebook / Meta Lead Ads → CRM ---
# App Meta for Developers (permissions: pages_show_list, pages_read_engagement,
# leads_retrieval, pages_manage_metadata). Webhook Page → champ leadgen.
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
# Jeton de vérification du webhook (hub.verify_token)
FACEBOOK_VERIFY_TOKEN=""
# Page Access Token longue durée : à coller dans /admin/facebook-leads
# (stocké chiffré en base, jamais exposé en clair).

# --- Autres réseaux (connecteurs DIG-SOC — secrets optionnels) ---
# LinkedIn Lead Gen
# LINKEDIN_CLIENT_ID=""
# LINKEDIN_CLIENT_SECRET=""
# X (Twitter) API
# X_API_KEY=""
# X_API_SECRET=""
# TikTok Lead Generation
# TIKTOK_APP_ID=""
# TIKTOK_APP_SECRET=""
# WhatsApp Cloud API
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
