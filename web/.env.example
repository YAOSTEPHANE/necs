# --- Vercel Blob (stockage images / fichiers) ---
# Créer un store : Vercel Dashboard → Storage → Blob → Create
# Puis copier le token ici ET dans Vercel → Settings → Environment Variables
BLOB_READ_WRITE_TOKEN=""

# --- Base de données (optionnel pour l’instant) ---
DATABASE_URL=""

DB_HOST=""
DB_PORT="3306"
DB_NAME=""
DB_USER=""
DB_PASSWORD=""
DB_SSL="true"

# --- App ---
NEXT_PUBLIC_APP_URL="https://servicesnecs.vercel.app"
